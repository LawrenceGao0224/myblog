---
import Base from '../layouts/Base.astro';
import WithSidebar from '../layouts/WithSidebar.astro';
import Carousel from '../components/Carousel.astro';
import StoryCard from '../components/StoryCard.astro';
import { SITE } from '../config';
import { getPosts, url } from '../utils';

const posts = await getPosts();
// 輪播放最新 5 篇（有封面的），其餘接在下面
const slides = posts.filter((p) => p.data.cover).slice(0, 5);
const rest = posts.filter((p) => !slides.includes(p));
const recent = rest.slice(0, 2);
const more = rest.slice(2, 12);
---
<Base>
  <Carousel posts={slides} />

  <section class="wrap-wide masthead reveal">
    <p class="kicker">Travel · Work · Life</p>
    <h1 class="serif">{SITE.subtitle}</h1>
  </section>

  <WithSidebar posts={posts}>
    <h2 class="section-title">最新文章</h2>
    <div class="pair">
      {recent.map((p) => <StoryCard post={p} />)}
    </div>

    <h2 class="section-title">更多文章</h2>
    <div class="compact">
      {more.map((p) => <StoryCard post={p} size="sm" />)}
    </div>

    <a class="all reveal" href={url('/archive/')}>瀏覽全部 {posts.length} 篇文章 →</a>
  </WithSidebar>
</Base>

<style>
  .masthead { padding-top: 56px; padding-bottom: 48px; }
  .masthead h1 { margin: 10px 0 0; max-width: 820px; font-size: clamp(26px, 4vw, 40px); font-weight: 400; line-height: 1.3; letter-spacing: -0.01em; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 0 0 64px; }
  .compact { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; }
  .all {
    display: block;
    margin-top: 48px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    font-size: 15px;
    transition: border-color 0.2s, color 0.2s;
  }
  .all:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 720px) {
    .pair, .compact { grid-template-columns: 1fr; }
    .pair { gap: 44px; }
  }
</style>
