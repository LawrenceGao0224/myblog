---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts } from '../utils';
import header from '../assets/site-header.jpg';

const posts = await getPosts();
const lastPage = Math.ceil(posts.length / SITE.postsPerPage);
---
<Base>
  <Hero slot="hero" image={header} title={SITE.title} subtitle={SITE.subtitle} />
  <div class="wrap-wide home">
    <PostList posts={posts.slice(0, SITE.postsPerPage)} page={1} lastPage={lastPage} />
  </div>
</Base>

<style>
  .home { max-width: 900px; margin-top: 32px; }
</style>
