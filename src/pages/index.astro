---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config';
import { getPosts } from '../utils';

const posts = await getPosts();
const lastPage = Math.ceil(posts.length / SITE.postsPerPage);
---
<Base>
  <PageHeading title={SITE.title} subtitle={SITE.subtitle} posts={posts} />
  <div class="wrap-wide">
    <p class="section-label">最新文章</p>
    <PostList posts={posts.slice(0, SITE.postsPerPage)} page={1} lastPage={lastPage} feature />
  </div>
</Base>

<style>
  .section-label { margin: 36px 0 18px; text-align: right; font-size: 17px; }
</style>
