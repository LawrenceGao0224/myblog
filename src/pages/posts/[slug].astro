---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import { formatDate, getPosts, postUrl, readingMinutes, tagUrl, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { title, description, published, cover, tags, toc } = post.data;
const { Content, headings } = await render(post);
const tocItems = toc ? headings.filter((h) => h.depth <= 2) : [];
const pageUrl = new URL(postUrl(post), Astro.site).href;
const share = [
  { label: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
  { label: 'LINE', icon: 'line', href: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}` },
  { label: 'X', icon: 'x', href: `https://x.com/intent/post?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}` },
] as const;
---
<Base title={title} description={description || title} image={cover?.src}>
  <header class="wrap-wide post-head">
    <p class="meta">
      發佈於 <strong>{formatDate(published)}</strong> · <strong>{readingMinutes(post)} 分鐘閱讀</strong>
    </p>
    <h1>{title}</h1>
    {description && <p class="desc">{description}</p>}
    <p class="tags">{tags.map((t) => <a class="tag" href={tagUrl(t)}>{t}</a>)}</p>
    {cover && (
      <Image class="cover" src={cover} alt="" widths={[640, 1200, 1920]} sizes="(max-width: 1152px) 100vw, 1120px" loading="eager" fetchpriority="high" layout="none" />
    )}
  </header>

  <div class="wrap-wide post-body">
    <aside>
      <div class="sticky">
        <h2>分享</h2>
        <div class="share">
          {share.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={`分享到 ${s.label}`}><Icon name={s.icon} size={18} /></a>
          ))}
          <button type="button" id="copy-link" data-url={pageUrl} aria-label="複製連結"><Icon name="link" size={18} /></button>
        </div>
        {tocItems.length > 1 && (
          <details class="toc" open>
            <summary><h2>目錄</h2></summary>
            <ol>
              {tocItems.map((h) => (
                <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-id={h.slug}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        )}
      </div>
    </aside>

    <div class="main-col">
      <article class="prose">
        <Content />
      </article>

      <nav class="adjacent" aria-label="其他文章">
        {newer ? <a href={postUrl(newer)}><span>← 較新文章</span>{newer.data.title}</a> : <span />}
        {older ? <a class="right" href={postUrl(older)}><span>較舊文章 →</span>{older.data.title}</a> : <span />}
      </nav>

      <Giscus />
    </div>
  </div>
  <Lightbox />
</Base>

<script>
  // 目錄：標示目前讀到的段落
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.dataset.id!, a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(e.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-80px 0px -70% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
  // 手機上目錄預設收合
  if (matchMedia('(max-width: 900px)').matches) document.querySelector('.toc')?.removeAttribute('open');

  const copy = document.getElementById('copy-link');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.url!);
      copy.classList.add('done');
      setTimeout(() => copy.classList.remove('done'), 1500);
    } catch {}
  });
</script>

<style>
  .post-head { padding-top: 40px; text-align: center; }
  .meta { margin: 0; font-size: 13px; color: var(--muted); }
  .meta strong { color: var(--text); font-weight: 600; }
  h1 { margin: 8px auto 0; max-width: 900px; font-size: clamp(30px, 5vw, 48px); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }
  .desc { margin: 12px 0 0; color: var(--muted); font-size: 17px; }
  .tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; }
  .cover { display: block; width: 100%; max-height: 560px; margin-top: 28px; object-fit: cover; border-radius: var(--radius); }

  .post-body { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border); }
  .sticky { position: sticky; top: 88px; max-height: calc(100vh - 110px); overflow-y: auto; }
  aside h2 { display: inline; margin: 0; font-size: 18px; font-weight: 700; }
  .share { display: flex; gap: 8px; margin: 10px 0 28px; }
  .share a, .share button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px;
    border: 0; border-radius: 6px;
    background: var(--accent); color: #fff; cursor: pointer;
  }
  .share a:hover, .share button:hover { filter: brightness(1.1); }
  .share button:global(.done) { background: #16a34a; }
  .toc summary { cursor: pointer; list-style: none; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin: 12px 0 0; padding: 0; list-style: none; }
  .toc a {
    display: inline-block;
    padding: 5px 11px;
    border-radius: 14px;
    background: var(--pill);
    color: var(--text);
    font-size: 13px;
    line-height: 1.4;
  }
  .toc .d2 { margin-left: 10px; }
  .toc a:hover { text-decoration: none; filter: brightness(0.95); }
  .toc a:global(.active) { background: var(--accent); color: #fff; }

  .main-col { min-width: 0; max-width: var(--content); }
  .adjacent { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--border); }
  .adjacent a { display: flex; flex-direction: column; gap: 4px; color: var(--text); font-size: 15px; font-weight: 600; line-height: 1.5; }
  .adjacent a span { color: var(--muted); font-size: 13px; font-weight: 400; }
  .adjacent .right { text-align: right; }

  @media (max-width: 900px) {
    .post-body { grid-template-columns: 1fr; gap: 0; }
    .sticky { position: static; max-height: none; overflow: visible; }
    .share { margin-bottom: 20px; }
    .toc { margin-bottom: 24px; padding: 14px 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
    .toc summary h2::after { content: ' ▾'; font-size: 14px; color: var(--muted); }
  }
  @media (max-width: 600px) {
    .post-head { padding-top: 24px; }
    .adjacent { grid-template-columns: 1fr; }
    .adjacent .right { text-align: left; }
  }
</style>
