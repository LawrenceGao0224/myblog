---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Giscus from '../../components/Giscus.astro';
import Icon from '../../components/Icon.astro';
import Lightbox from '../../components/Lightbox.astro';
import StoryCard from '../../components/StoryCard.astro';
import { AUTHOR, SOCIAL } from '../../config';
import { categoryUrl, formatDate, getPosts, postUrl, readingMinutes, relatedPosts, tagUrl, url, type Post } from '../../utils';
import avatar from '../../assets/avatar.jpg';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, posts, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, posts, newer, older } = Astro.props as { post: Post; posts: Post[]; newer?: Post; older?: Post };
const { title, description, published, cover, tags, category, toc } = post.data;
const { Content, headings } = await render(post);
const tocItems = toc ? headings.filter((h) => h.depth <= 2) : [];
const related = relatedPosts(post, posts);
const pageUrl = new URL(postUrl(post), Astro.site).href;
const share = [
  { label: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
  { label: 'LINE', icon: 'line', href: `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}` },
  { label: 'X', icon: 'x', href: `https://x.com/intent/post?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}` },
] as const;
---
<Base title={title} description={description || title} image={cover?.src}>
  <header class="wrap head reveal">
    <p class="kicker-row">
      {category && <a class="kicker" href={categoryUrl(category)}>{category}</a>}
      {tags[0] && tags[0] !== category && <a class="kicker" href={tagUrl(tags[0])}>{tags[0]}</a>}
    </p>
    <h1 class="serif">{title}</h1>
    {description && <p class="dek serif">{description}</p>}
    <div class="byline">
      <Image class="mini-avatar" src={avatar} alt="" width={40} height={40} densities={[1, 2]} />
      <div>
        <a class="who" href={url('/about/')}>{AUTHOR.name}</a>
        <p class="when muted">
          <time datetime={published.toISOString()}>{formatDate(published)}</time> · {readingMinutes(post)} 分鐘閱讀
        </p>
      </div>
    </div>
  </header>

  {cover && (
    <figure class="cover wrap-wide reveal">
      <Image src={cover} alt="" widths={[640, 1200, 1920]} sizes="(max-width: 1200px) 100vw, 1160px" loading="eager" fetchpriority="high" layout="none" />
    </figure>
  )}

  <div class="body">
    <aside class="rail">
      <div class="sticky">
        {tocItems.length > 1 && (
          <details class="toc" open>
            <summary>本文目錄</summary>
            <ol>
              {tocItems.map((h) => (
                <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-id={h.slug}>{h.text}</a></li>
              ))}
            </ol>
          </details>
        )}
        <div class="share">
          <span class="label">分享</span>
          {share.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={`分享到 ${s.label}`}><Icon name={s.icon} size={17} /></a>
          ))}
          <button type="button" id="copy-link" data-url={pageUrl} aria-label="複製連結"><Icon name="link" size={17} /></button>
        </div>
      </div>
    </aside>

    <article class="prose">
      <Content />
    </article>
  </div>

  <div class="wrap after">
    {tags.length > 0 && <p class="tags">{tags.map((t) => <a class="tag" href={tagUrl(t)}>#{t}</a>)}</p>}

    <section class="author-card reveal">
      <Image class="avatar" src={avatar} alt="" width={88} height={88} densities={[1, 2]} />
      <div>
        <p class="kicker">關於作者</p>
        <h2 class="serif"><a href={url('/about/')}>{AUTHOR.name}</a></h2>
        <p class="bio">{AUTHOR.bio}</p>
        <div class="social">
          {SOCIAL.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={16} /></a>)}
        </div>
      </div>
    </section>

    <nav class="adjacent" aria-label="上一篇／下一篇">
      {older ? <a href={postUrl(older)}><span class="muted">← 上一篇</span><span class="serif">{older.data.title}</span></a> : <span />}
      {newer ? <a class="right" href={postUrl(newer)}><span class="muted">下一篇 →</span><span class="serif">{newer.data.title}</span></a> : <span />}
    </nav>

    <Giscus />
  </div>

  {related.length > 0 && (
    <section class="wrap-wide related">
      <h2 class="section-title">延伸閱讀</h2>
      <div class="grid">{related.map((p) => <StoryCard post={p} />)}</div>
    </section>
  )}

  <Lightbox />
</Base>

<script>
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.dataset.id!, a]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(e.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-90px 0px -70% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
  if (matchMedia('(max-width: 1100px)').matches) document.querySelector('.toc')?.removeAttribute('open');

  const copy = document.getElementById('copy-link');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.url!);
      copy.classList.add('done');
      setTimeout(() => copy.classList.remove('done'), 1500);
    } catch {}
  });
</script>

<style>
  .head { padding-top: 64px; text-align: center; }
  .kicker-row { display: flex; justify-content: center; gap: 16px; margin: 0; }
  h1 { margin: 14px 0 0; font-size: clamp(32px, 5.5vw, 52px); line-height: 1.15; letter-spacing: -0.02em; }
  .dek { margin: 18px auto 0; max-width: 560px; color: var(--muted); font-size: 20px; font-style: italic; line-height: 1.55; }
  .byline { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; text-align: left; }
  .mini-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .who { font-size: 15px; font-weight: 600; }
  .who:hover { color: var(--accent); }
  .when { margin: 0; font-size: 13px; }

  .cover { margin: 44px auto 0; }
  .cover img { display: block; width: 100%; max-height: 640px; object-fit: cover; border-radius: var(--radius); }

  .body { display: grid; grid-template-columns: 1fr minmax(0, var(--content)) 1fr; gap: 48px; max-width: 1200px; margin: 56px auto 0; padding: 0 20px; }
  .rail { grid-column: 1; justify-self: end; width: 220px; }
  .prose { grid-column: 2; }
  .sticky { position: sticky; top: 96px; max-height: calc(100vh - 120px); overflow-y: auto; }
  .toc summary { cursor: pointer; list-style: none; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: var(--muted); }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { list-style: none; margin: 12px 0 0; padding: 0; border-left: 1px solid var(--border); }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc .d2 a { padding-left: 26px; font-size: 13px; }
  .toc a:hover { color: var(--text); }
  .toc a:global(.active) { color: var(--accent); border-left-color: var(--accent); }
  .share { display: flex; align-items: center; gap: 6px; margin-top: 28px; }
  .label { margin-right: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: var(--muted); }
  .share a, .share button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px;
    border: 1px solid var(--border); border-radius: 50%;
    background: none; color: var(--muted); cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .share a:hover, .share button:hover { color: var(--accent); border-color: var(--accent); }
  .share button:global(.done) { color: #4ade80; border-color: #4ade80; }

  .after { margin-top: 48px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 40px; }
  .author-card { display: grid; grid-template-columns: 88px 1fr; gap: 24px; padding: 28px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .author-card .avatar { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
  .author-card h2 { margin: 4px 0 6px; font-size: 22px; }
  .author-card h2 a:hover { color: var(--accent); }
  .bio { margin: 0 0 12px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .social { display: flex; gap: 6px; }
  .social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px;
    border: 1px solid var(--border); border-radius: 50%; color: var(--muted);
  }
  .social a:hover { color: var(--accent); border-color: var(--accent); }

  .adjacent { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; padding: 28px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .adjacent a { display: flex; flex-direction: column; gap: 6px; }
  .adjacent a .muted { font-size: 13px; }
  .adjacent a .serif { font-size: 18px; line-height: 1.4; transition: color 0.2s; }
  .adjacent a:hover .serif { color: var(--accent); }
  .adjacent .right { text-align: right; }

  .related { margin-top: 88px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }

  @media (max-width: 1100px) {
    .body { display: block; max-width: calc(var(--content) + 40px); margin-top: 40px; }
    .rail { width: auto; margin-bottom: 32px; }
    .sticky { position: static; max-height: none; overflow: visible; }
    .toc { padding: 14px 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
    .toc summary::after { content: ' ▾'; }
    .share { margin-top: 18px; }
  }
  @media (max-width: 720px) {
    .head { padding-top: 40px; }
    .dek { font-size: 18px; }
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .author-card { grid-template-columns: 1fr; text-align: center; justify-items: center; }
    .social { justify-content: center; }
    .adjacent { grid-template-columns: 1fr; }
    .adjacent .right { text-align: left; }
  }
</style>
