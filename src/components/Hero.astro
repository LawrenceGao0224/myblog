---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { image?: ImageMetadata; title: string; subtitle?: string; small?: boolean }
const { image, title, subtitle, small = false } = Astro.props;
---
<section class:list={['hero', { small, plain: !image }]}>
  {image && <Image src={image} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" layout="none" />}
  <div class="overlay">
    <div class="wrap">
      <slot name="above" />
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 46vh; min-height: 300px; max-height: 520px; overflow: hidden; background: #333; }
  .hero.small { height: 32vh; min-height: 220px; }
  .hero.plain { height: auto; min-height: 0; background: none; }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .overlay {
    position: relative;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding-bottom: 32px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0.1) 60%);
    color: #fff;
  }
  .plain .overlay { background: none; color: var(--text); padding: 40px 0 8px; }
  .overlay .wrap { width: 100%; }
  h1 { margin: 0.2em 0; font-size: clamp(26px, 5vw, 40px); line-height: 1.3; text-shadow: 0 2px 12px rgb(0 0 0 / 0.3); }
  .plain h1 { text-shadow: none; }
  .subtitle { margin: 0; font-size: clamp(15px, 2.5vw, 18px); opacity: 0.92; }
</style>
