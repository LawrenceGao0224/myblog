---
import PostCard from './PostCard.astro';
import { url, type Post } from '../utils';

interface Props { posts: Post[]; page: number; lastPage: number }
const { posts, page, lastPage } = Astro.props;
const pageHref = (n: number) => (n === 1 ? url('/') : url(`/page/${n}/`));
---
<div class="list">
  {posts.map((post, i) => <PostCard post={post} eager={page === 1 && i < 2} />)}
</div>
{lastPage > 1 && (
  <nav class="pager" aria-label="分頁">
    {page > 1 ? <a href={pageHref(page - 1)}>← 較新</a> : <span />}
    <span class="muted">{page} / {lastPage}</span>
    {page < lastPage ? <a href={pageHref(page + 1)}>較舊 →</a> : <span />}
  </nav>
)}

<style>
  .list { display: grid; gap: 20px; }
  .pager { display: flex; justify-content: space-between; align-items: center; margin-top: 32px; font-size: 15px; }
  .pager a { padding: 8px 16px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
</style>
