---
import { T } from '../i18n';
import { formatDate, langOfPost, readingMinutes, type Post } from '../utils';
interface Props { post: Post }
const { post } = Astro.props;
const lang = langOfPost(post);
---
<p class="meta">
  <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, lang)}</time>
  <span aria-hidden="true">·</span>
  <span>{T[lang].minRead(readingMinutes(post))}</span>
</p>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; color: var(--muted); font-size: 13px; }
</style>
