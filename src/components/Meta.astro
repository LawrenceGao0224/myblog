---
import { formatDate, readingMinutes, type Post } from '../utils';
interface Props { post: Post }
const { post } = Astro.props;
---
<p class="meta">
  <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
  <span aria-hidden="true">·</span>
  <span>{readingMinutes(post)} 分鐘閱讀</span>
</p>

<style>
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; color: var(--muted); font-size: 13px; }
</style>
