---
import { Image } from 'astro:assets';
import Meta from './Meta.astro';
import { langOfPost, postUrl, tagUrl, type Post } from '../utils';

// size="md"：圖在上、文字在下；size="sm"：左圖右文的精簡列
interface Props { post: Post; size?: 'md' | 'sm' }
const { post, size = 'md' } = Astro.props;
const { title, description, cover, tags } = post.data;
---
<article class:list={['card', size, 'reveal']}>
  <a class="media" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    {cover && <Image src={cover} alt="" widths={size === 'sm' ? [240, 480] : [480, 800]} sizes={size === 'sm' ? '140px' : '(max-width: 640px) 100vw, 400px'} loading="lazy" layout="none" />}
  </a>
  <div class="text">
    {tags[0] && <a class="kicker" href={tagUrl(tags[0], langOfPost(post))}>{tags[0]}</a>}
    <h3 class="serif"><a href={postUrl(post)}>{title}</a></h3>
    {size === 'md' && description && <p class="dek">{description}</p>}
    <Meta post={post} />
  </div>
</article>

<style>
  .card { min-width: 0; }
  .media { display: block; overflow: hidden; border-radius: var(--radius); background: var(--surface-2); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .card:hover .media img { transform: scale(1.04); }
  h3 { margin: 6px 0 8px; line-height: 1.35; letter-spacing: -0.005em; }
  h3 a { background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1.5px no-repeat; transition: background-size 0.3s; }
  h3 a:hover { background-size: 100% 1.5px; }
  .dek {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .md .media { aspect-ratio: 3 / 2; }
  .md .text { padding-top: 16px; }
  .md h3 { font-size: 22px; }

  .sm { display: grid; grid-template-columns: 140px 1fr; gap: 16px; align-items: center; }
  .sm .media { aspect-ratio: 1; }
  .sm h3 { font-size: 17px; margin: 2px 0 6px; }
  @media (max-width: 400px) {
    .sm { grid-template-columns: 104px 1fr; gap: 12px; }
  }
</style>
