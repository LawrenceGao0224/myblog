---
import StoryCard from './StoryCard.astro';
import type { Post } from '../utils';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<div class="grid">{posts.map((p) => <StoryCard post={p} />)}</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 32px; }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
