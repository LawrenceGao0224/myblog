---
// 列表頁頁首：小標 + 襯線大標 + 說明
interface Props { kicker?: string; title: string; subtitle?: string }
const { kicker, title, subtitle } = Astro.props;
---
<header class="wrap-wide heading reveal">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="serif">{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
  .heading { padding-top: 56px; padding-bottom: 36px; margin-bottom: 44px; border-bottom: 1px solid var(--border); }
  .kicker { margin: 0 0 10px; }
  h1 { margin: 0; font-size: clamp(34px, 6vw, 56px); line-height: 1.1; letter-spacing: -0.02em; }
  .subtitle { margin: 14px 0 0; max-width: 640px; color: var(--muted); font-size: 17px; }
</style>
