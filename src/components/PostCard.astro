---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, postUrl, readingMinutes, type Post } from '../utils';

interface Props { post: Post; eager?: boolean; wide?: boolean }
const { post, eager = false, wide = false } = Astro.props;
const { title, description, published, cover, tags } = post.data;
---
<article class:list={['card', { wide }]}>
  <a class="thumb" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    {cover ? (
      <Image src={cover} alt="" widths={[480, 800, 1200]} sizes={wide ? '(max-width: 768px) 100vw, 760px' : '(max-width: 768px) 100vw, 380px'} loading={eager ? 'eager' : 'lazy'} layout="none" />
    ) : (
      <span class="placeholder" />
    )}
    <span class="band">
      <span class="when">
        <strong>{formatDate(published)}</strong>
        <span>{readingMinutes(post)} 分鐘閱讀</span>
      </span>
      {tags[0] && <span class="cat">{tags[0]}</span>}
    </span>
  </a>
  <div class="body">
    <h2><a href={postUrl(post)}>{title}</a></h2>
    {description && <p class="desc">{description}</p>}
    <a class="more" href={postUrl(post)}>閱讀文章 <Icon name="arrow" size={15} /></a>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; min-width: 0; }
  .thumb { position: relative; display: block; height: 240px; overflow: hidden; border-radius: var(--radius); background: var(--pill); }
  @media (max-width: 600px) {
    .thumb { height: auto; aspect-ratio: 4 / 3; }
  }
  .thumb img, .placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .card:hover .thumb img { transform: scale(1.03); }
  .band {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgb(0 0 0 / 0.38);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-size: 13px;
    line-height: 1.5;
  }
  .when { display: flex; flex-direction: column; }
  .when strong { font-weight: 600; }
  .when span { opacity: 0.85; font-size: 12px; }
  .cat { font-size: 14px; }
  .body { display: flex; flex-direction: column; flex: 1; padding: 16px 2px 0; }
  h2 { margin: 0 0 6px; font-size: 18px; font-weight: 600; line-height: 1.45; letter-spacing: -0.01em; }
  h2 a { color: var(--text); }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more { display: inline-flex; align-items: center; gap: 4px; margin-top: auto; padding-top: 16px; color: var(--text); font-size: 14px; font-weight: 600; }
  .more:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
