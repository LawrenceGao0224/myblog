---
import { Image } from 'astro:assets';
import { formatDate, postUrl, tagUrl, type Post } from '../utils';

interface Props { post: Post; eager?: boolean }
const { post, eager = false } = Astro.props;
const { title, description, published, cover, tags } = post.data;
---
<article class="card">
  {cover && (
    <a class="thumb" href={postUrl(post)} tabindex="-1" aria-hidden="true">
      <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 640px) 100vw, 260px" loading={eager ? 'eager' : 'lazy'} layout="none" />
    </a>
  )}
  <div class="body">
    <h2><a href={postUrl(post)}>{title}</a></h2>
    {description && <p class="desc">{description}</p>}
    <div class="meta">
      <time datetime={published.toISOString()}>{formatDate(published)}</time>
      {tags.map((t) => <a class="tag" href={tagUrl(t)}>{t}</a>)}
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 260px 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .thumb { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .card:hover .thumb img { transform: scale(1.04); }
  .body { padding: 18px 22px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  h2 { margin: 0; font-size: 20px; line-height: 1.4; }
  h2 a { color: var(--text); }
  .desc { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .meta { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; }
    .thumb { aspect-ratio: 16 / 9; }
    .body { padding: 14px 16px 16px; }
    h2 { font-size: 18px; }
  }
</style>
