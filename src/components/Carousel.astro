---
import { Image } from 'astro:assets';
import { T, langOf } from '../i18n';
import { formatDate, postUrl, readingMinutes, type Post } from '../utils';

// 首頁頂端的文章輪播：每 6 秒換一篇，可左右滑動、點圓點或箭頭切換
// 滑鼠移入、鍵盤聚焦或系統開啟「減少動態效果」時不自動播放
interface Props { posts: Post[] }
const { posts } = Astro.props;
const lang = langOf(Astro.url);
const t = T[lang];
---
<section class="carousel wrap-wide" aria-roledescription="carousel" aria-label={t.featured}>
  <div class="track" tabindex="0">
    {posts.map((post, i) => (
      <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} / ${posts.length}`}>
        {post.data.cover && (
          <Image src={post.data.cover} alt="" widths={[640, 1200, 1920]} sizes="(max-width: 1200px) 100vw, 1160px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} layout="none" />
        )}
        <div class="shade">
          <div class="text">
            {post.data.tags[0] && <p class="kicker">{post.data.tags[0]}</p>}
            <h2 class="serif"><a href={postUrl(post)}>{post.data.title}</a></h2>
            {post.data.description && <p class="dek">{post.data.description}</p>}
            <p class="meta">{formatDate(post.data.published, lang)} · {t.minRead(readingMinutes(post))}</p>
          </div>
        </div>
      </article>
    ))}
  </div>

  <button class="arrow prev" type="button" aria-label={t.prev}>‹</button>
  <button class="arrow next" type="button" aria-label={t.next}>›</button>
  <div class="dots" role="tablist" aria-label={t.pickSlide}>
    {posts.map((_, i) => <button type="button" role="tab" aria-label={t.slideN(i + 1)} aria-selected={i === 0 ? 'true' : 'false'}></button>)}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dots button')];
    let index = 0;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
    };
    // 依捲動位置更新圓點（手指滑動時也會對）
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i === index && dots[i].getAttribute('aria-selected') === 'true') return;
      index = i;
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
    }, { passive: true });

    root.querySelector('.prev')!.addEventListener('click', () => go(index - 1));
    root.querySelector('.next')!.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });

    if (matchMedia('(prefers-reduced-motion: reduce)').matches || slides.length < 2) return;
    let paused = false;
    const pause = () => (paused = true);
    const resume = () => (paused = false);
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', resume);
    track.addEventListener('touchstart', pause, { passive: true });
    track.addEventListener('touchend', () => setTimeout(resume, 4000), { passive: true });
    setInterval(() => {
      if (!paused && !document.hidden) go(index + 1);
    }, 6000);
  });
</script>

<style>
  .carousel { position: relative; margin-top: 28px; }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius);
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .slide {
    position: relative;
    flex: 0 0 100%;
    height: clamp(420px, 62vh, 600px);
    scroll-snap-align: start;
    background: var(--surface-2);
    overflow: hidden;
  }
  .slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(to top, rgb(10 8 6 / 0.85), rgb(10 8 6 / 0.25) 55%, transparent);
  }
  .text { max-width: 820px; padding: 0 104px 64px; color: #f5efe6; }
  h2 { margin: 10px 0 12px; font-size: clamp(28px, 4.5vw, 48px); line-height: 1.15; letter-spacing: -0.01em; }
  /* 整張投影片都可點：標題連結延伸覆蓋 */
  h2 a::after { content: ''; position: absolute; inset: 0; }
  h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .dek { margin: 0 0 12px; font-size: 18px; line-height: 1.55; opacity: 0.9; }
  .meta { margin: 0; font-size: 13px; opacity: 0.75; }

  .arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.3);
    color: #fff;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color 0.2s;
  }
  .arrow:hover { background: rgb(0 0 0 / 0.55); }
  .prev { left: 36px; }
  .next { right: 36px; }
  .dots { position: absolute; right: 56px; bottom: 30px; z-index: 2; display: flex; gap: 8px; }
  .dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.45);
    cursor: pointer;
    transition: width 0.3s, background-color 0.3s;
  }
  .dots button[aria-selected='true'] { width: 28px; background: var(--accent); }

  @media (max-width: 720px) {
    .carousel { padding: 0; margin-top: 0; }
    .track { border-radius: 0; }
    .slide { height: 72vh; min-height: 440px; }
    .text { padding: 0 20px 56px; }
    .dek { font-size: 16px; }
    .arrow { display: none; }
    .dots { left: 20px; right: auto; bottom: 26px; }
  }
</style>
