---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { AUTHOR, FEATURED, SOCIAL } from '../config';
import { allCategories, allTags, categoryUrl, postUrl, tagUrl, url, type Post } from '../utils';
import avatar from '../assets/avatar.jpg';

// 右側資訊欄：作者、推薦閱讀、分類、標籤
interface Props { posts: Post[] }
const { posts } = Astro.props;
const picks = FEATURED.map((id) => posts.find((p) => p.id === id)).filter((p): p is Post => !!p);
---
<aside class="sidebar">
  <section class="author reveal">
    <Image class="avatar" src={avatar} alt={AUTHOR.name} width={96} height={96} densities={[1, 2]} />
    <h2 class="serif">{AUTHOR.name}</h2>
    <p class="role">{AUTHOR.role}</p>
    <p class="bio">{AUTHOR.bio}</p>
    <div class="social">
      {SOCIAL.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={17} /></a>)}
    </div>
    <a class="more" href={url('/about/')}>認識我 →</a>
  </section>

  {picks.length > 0 && (
    <section class="reveal">
      <h2 class="section-title">推薦閱讀</h2>
      <ol class="picks">
        {picks.map((p, i) => (
          <li>
            <span class="num serif">{String(i + 1).padStart(2, '0')}</span>
            <a class="serif" href={postUrl(p)}>{p.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="reveal">
    <h2 class="section-title">分類</h2>
    <ul class="cats">
      {allCategories(posts).map(([c, n]) => (
        <li><a href={categoryUrl(c)}><span>{c}</span><span class="muted">{n}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="reveal">
    <h2 class="section-title">標籤</h2>
    <div class="tags">{allTags(posts).map(([t]) => <a class="tag" href={tagUrl(t)}>#{t}</a>)}</div>
  </section>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 44px; }
  .author { padding: 28px 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); text-align: center; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
  .author h2 { margin: 14px 0 2px; font-size: 20px; }
  .role { margin: 0; color: var(--accent); font-size: 13px; letter-spacing: 0.06em; }
  .bio { margin: 12px 0 16px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .social { display: flex; justify-content: center; gap: 6px; }
  .social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px;
    border: 1px solid var(--border); border-radius: 50%;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .social a:hover { color: var(--accent); border-color: var(--accent); }
  .more { display: inline-block; margin-top: 16px; color: var(--accent); font-size: 14px; }

  .picks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .picks li { display: grid; grid-template-columns: 36px 1fr; gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .picks li:first-child { padding-top: 0; }
  .num { color: var(--accent); font-size: 20px; line-height: 1.3; }
  .picks a { font-size: 16px; line-height: 1.45; }
  .picks a:hover { color: var(--accent); }

  .cats { list-style: none; margin: 0; padding: 0; }
  .cats a { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .cats a:hover span:first-child { color: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
