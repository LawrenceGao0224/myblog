---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL } from '../config';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { label: '首頁', href: url('/') },
  { label: '文章', href: url('/archive/') },
  { label: '標籤', href: url('/tags/') },
  { label: '關於', href: url('/about/') },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="google-site-verification" content="SyDj2XyyHM_O0z5ErRUw2G1d0Gum-3JBYv8n-Qg0aVs" />
    <meta name="google-site-verification" content="xBT4GhYoi5qRD5tr338pgPM5OWHHIDR6mNg1a3euekI" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap-wide bar">
        <a class="brand" href={url('/')}>{SITE.title}</a>
        <nav aria-label="主選單">
          {nav.slice(1).map((n) => (
            <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>
              {n.label === '標籤' && <Icon name="tag" size={17} />}
              {n.label}
            </a>
          ))}
          <span class="divider" aria-hidden="true"></span>
          {SOCIAL.slice(0, 2).map((s) => (
            <a class="icon social" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} /></a>
          ))}
          <button id="theme-toggle" class="icon" type="button" aria-label="切換深色模式">
            <span class="moon"><Icon name="moon" /></span>
            <span class="sun"><Icon name="sun" /></span>
          </button>
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <p class="social-row">
          {SOCIAL.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a>)}
        </p>
        <p>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 12px; }
  .brand { font-weight: 600; font-size: 16px; color: var(--text); white-space: nowrap; }
  .brand:hover { text-decoration: none; opacity: 0.7; }
  nav { display: flex; align-items: center; gap: 2px; }
  nav a, .icon {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 9px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--text);
    font: 500 14px/1 var(--font);
    white-space: nowrap;
    cursor: pointer;
  }
  nav a:hover, .icon:hover { text-decoration: none; background: var(--pill); }
  nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .divider { width: 2px; height: 20px; margin: 0 8px; background: var(--text); }
  .sun { display: none; }
  :global([data-theme='dark']) .sun { display: inline-flex; }
  :global([data-theme='dark']) .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: inline-flex; }
    :global(:root:not([data-theme='light'])) .moon { display: none; }
  }
  main { min-height: 60vh; }
  .site-footer { margin-top: 80px; text-align: center; font-size: 14px; }
  .site-footer .wrap-wide { padding-top: 28px; padding-bottom: 40px; border-top: 1px solid var(--border); }
  .site-footer p { margin: 6px 0; }
  .social-row { display: flex; justify-content: center; gap: 14px; }
  .social-row a { color: var(--muted); }
  .social-row a:hover { color: var(--text); }
  @media (max-width: 640px) {
    nav .social, .divider { display: none; }
    .brand { font-size: 15px; }
    nav a, .icon { padding: 6px 7px; }
  }
</style>
