---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { T, langOf } from '../i18n';
import { formatDate, getPosts, postUrl, yearOf } from '../utils';

const lang = langOf(Astro.url);
const t = T[lang];
const posts = await getPosts(lang);
const byYear = new Map<string, typeof posts>();
for (const p of posts) {
  const y = yearOf(p.data.published);
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---
<Base title={t.allPosts}>
  <PageHeading kicker="Archive" title={t.allPosts} subtitle={t.archiveSub(posts.length)} />
  <div class="wrap-wide">
    {[...byYear].map(([year, list]) => (
      <section class="year reveal">
        <h2 class="serif">{year}</h2>
        <ul>
          {list.map((p) => (
            <li>
              <time class="muted">{lang === 'en' ? formatDate(p.data.published, lang).replace(/,\s*\d{4}$/, '') : formatDate(p.data.published).slice(5)}</time>
              <a class="serif" href={postUrl(p)}>{p.data.title}</a>
              {p.data.tags[0] && <span class="kicker">{p.data.tags[0]}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .year { display: grid; grid-template-columns: 140px 1fr; gap: 24px; padding: 32px 0; border-bottom: 1px solid var(--border); }
  .year h2 { margin: 0; font-size: 36px; line-height: 1; color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 56px 1fr auto; gap: 16px; align-items: baseline; padding: 10px 0; }
  time { font-size: 14px; font-variant-numeric: tabular-nums; }
  li a { font-size: 19px; line-height: 1.4; transition: color 0.2s; }
  li a:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .year { grid-template-columns: 1fr; gap: 12px; }
    li { grid-template-columns: 48px 1fr; }
    li .kicker { display: none; }
    li a { font-size: 17px; }
  }
</style>
